package web

import (
	"fmt"
	"github.com/dustin/go-humanize"
)

// LayoutOptions holds optional display settings for the Layout template.
type LayoutOptions struct {
	Instances           []InstanceInfo
	ShowTroubleshooting bool
	NavStats            NavStats
}

templ Layout(title string, username string, opts LayoutOptions) {
	<!DOCTYPE html>
	<html lang="en" data-theme="dark">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
			<title>{ title } - Reducarr</title>
			<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2338bdf8' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M13 10V3L4 14h7v7l9-11h-7z'%3E%3C/path%3E%3C/svg%3E"/>
			<style>
				html {
					scrollbar-gutter: stable;
				}
				@media (min-width: 1024px) {
					.drawer.lg\:drawer-open {
						display: grid;
						grid-template-columns: 20rem 1fr;
					}
					.drawer.lg\:drawer-open > .drawer-content {
						grid-column-start: 2;
					}
					.drawer.lg\:drawer-open > .drawer-side {
						grid-column-start: 1;
						width: 20rem;
					}
				}
			</style>
			<link href="https://cdn.jsdelivr.net/npm/daisyui@5/daisyui.css" rel="stylesheet" type="text/css"/>
			<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
			<script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.10" defer></script>
			<style>
				.htmx-indicator { display: none; }
				.htmx-request .htmx-indicator { display: inline-block; }
				.htmx-request.htmx-indicator { display: inline-block; }
			</style>
		</head>
		<body class="min-h-screen bg-base-200 text-base-content">
			<div class="drawer lg:drawer-open">
				<input id="main-drawer" type="checkbox" class="drawer-toggle"/>
				<div class="drawer-content flex flex-col">
					<!-- Navbar -->
					<div class="navbar bg-base-100 shadow-sm w-full lg:hidden border-b border-base-300">
						<div class="flex-none">
							<label for="main-drawer" aria-label="open sidebar" class="btn btn-square btn-ghost">
								<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block w-6 h-6 stroke-current"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
							</label>
						</div>
						<div class="flex-1 px-2 mx-2 text-xl font-bold">
							<a href="/" class="hover:text-primary transition-colors">Reducarr</a>
						</div>
					</div>
					<!-- Page Content -->
					<main class="p-4 lg:p-8">
						{ children... }
					</main>
				</div>
				<!-- Sidebar -->
				<div class="drawer-side z-20">
					<label for="main-drawer" aria-label="close sidebar" class="drawer-overlay"></label>
					<div class="menu p-4 w-80 min-h-full bg-base-100 text-base-content flex flex-col border-r border-base-300">
						<a href="/" class="px-4 py-6 text-2xl font-bold mb-4 flex items-center gap-2 hover:opacity-80 transition-opacity group">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary group-hover:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
							<span>Reducarr</span>
						</a>
						<ul class="flex-1 space-y-1">
							<li>
								<a href="/" class="flex items-center gap-3 py-3 rounded-lg hover:bg-base-200">
									<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
									Dashboard
								</a>
							</li>
							<li>
								if len(opts.Instances) > 0 {
									<details open>
										<summary class="flex items-center justify-between gap-3 py-3 rounded-lg hover:bg-base-200">
											<div class="flex items-center gap-3">
												<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
												<span>Candidates</span>
											</div>
											if opts.NavStats.OptimizableBytes > 0 {
												<span class="badge badge-primary badge-sm font-bold font-mono mr-2" title="Estimated optimizable space">
													~{ humanize.Bytes(uint64(opts.NavStats.OptimizableBytes)) }
												</span>
											}
										</summary>
										<ul class="mt-1 space-y-1 pl-4">
											<li>
												<a href="/candidates" class="flex items-center justify-between py-2 text-xs rounded-lg hover:bg-base-200">
													<span>All Instances</span>
													if opts.NavStats.OptimizableBytes > 0 {
														<span class="badge badge-primary badge-xs font-mono" title="Estimated optimizable space">
															~{ humanize.Bytes(uint64(opts.NavStats.OptimizableBytes)) }
														</span>
													}
												</a>
											</li>
											for _, inst := range opts.Instances {
												<li>
													<a href={ templ.SafeURL(fmt.Sprintf("/candidates?instance=%s", inst.Name)) } class="flex items-center justify-between py-2 text-xs rounded-lg hover:bg-base-200">
														<span class="truncate flex items-center gap-1">
															{ inst.Name }
															<span class="badge badge-ghost badge-xs uppercase font-bold text-[9px]">{ inst.ArrType }</span>
														</span>
														if inst.ArrType == "sonarr" && opts.NavStats.SonarrOptimizable > 0 {
															<span class="badge badge-info badge-xs font-mono" title="Estimated savings (series > 2GB)">
																~{ humanize.Bytes(uint64(opts.NavStats.SonarrOptimizable)) }
															</span>
														} else if inst.ArrType == "radarr" && opts.NavStats.RadarrOptimizable > 0 {
															<span class="badge badge-warning badge-xs font-mono" title="Estimated savings (films > 4GB)">
																~{ humanize.Bytes(uint64(opts.NavStats.RadarrOptimizable)) }
															</span>
														}
													</a>
												</li>
											}
										</ul>
									</details>
								} else {
									<details open>
										<summary class="flex items-center justify-between gap-3 py-3 rounded-lg hover:bg-base-200">
											<div class="flex items-center gap-3">
												<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
												<span>Candidates</span>
											</div>
											if opts.NavStats.OptimizableBytes > 0 {
												<span class="badge badge-primary badge-sm font-bold font-mono mr-2" title="Estimated optimizable space">
													~{ humanize.Bytes(uint64(opts.NavStats.OptimizableBytes)) }
												</span>
											}
										</summary>
										<ul class="mt-1 space-y-1 pl-4">
											<li>
												<a href="/candidates" class="flex items-center justify-between py-2 text-xs rounded-lg hover:bg-base-200">
													<span>All instances</span>
													if opts.NavStats.OptimizableBytes > 0 {
														<span class="badge badge-primary badge-xs font-mono" title="Estimated optimizable space">
															~{ humanize.Bytes(uint64(opts.NavStats.OptimizableBytes)) }
														</span>
													}
												</a>
											</li>
											<li>
												<a href="/candidates?arr_type=sonarr" class="flex items-center justify-between py-2 text-xs rounded-lg hover:bg-base-200">
													<span class="flex items-center gap-1">
														Sonarr
														<span class="badge badge-ghost badge-xs uppercase font-bold text-[9px]">series</span>
													</span>
													if opts.NavStats.SonarrOptimizable > 0 {
														<span class="badge badge-info badge-xs font-mono" title="Estimated savings (series > 2 GB)">
															~{ humanize.Bytes(uint64(opts.NavStats.SonarrOptimizable)) }
														</span>
													}
												</a>
											</li>
											<li>
												<a href="/candidates?arr_type=radarr" class="flex items-center justify-between py-2 text-xs rounded-lg hover:bg-base-200">
													<span class="flex items-center gap-1">
														Radarr
														<span class="badge badge-ghost badge-xs uppercase font-bold text-[9px]">films</span>
													</span>
													if opts.NavStats.RadarrOptimizable > 0 {
														<span class="badge badge-warning badge-xs font-mono" title="Estimated savings (films > 4 GB)">
															~{ humanize.Bytes(uint64(opts.NavStats.RadarrOptimizable)) }
														</span>
													}
												</a>
											</li>
										</ul>
									</details>
								}
							</li>
							<li>
								<a href="/reports" class="flex items-center justify-between py-3 rounded-lg hover:bg-base-200">
									<div class="flex items-center gap-3">
										<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
										<span>Reports</span>
									</div>
									<div class="flex items-center gap-1.5">
										if opts.NavStats.DownloadingCount > 0 {
											<span class="badge badge-info badge-soft badge-xs font-bold" title="Active torrent downloads">
												{ fmt.Sprintf("%d dl", opts.NavStats.DownloadingCount) }
											</span>
										}
										if opts.NavStats.UnreadErrors > 0 {
											<span class="badge badge-error badge-xs font-bold animate-pulse" title="Unread failed actions">
												{ fmt.Sprintf("%d", opts.NavStats.UnreadErrors) }
											</span>
										}
									</div>
								</a>
							</li>
							<li>
								<a href="/search" class="flex items-center gap-3 py-3 rounded-lg hover:bg-base-200">
									<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
									Search
								</a>
							</li>
							<li>
								<a href="/settings" class="flex items-center gap-3 py-3 rounded-lg hover:bg-base-200">
									<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
									Settings
								</a>
							</li>
							if opts.ShowTroubleshooting {
								<li>
									<a href="/troubleshooting" class="flex items-center gap-3 py-3 rounded-lg hover:bg-base-200 text-warning">
										<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
										Troubleshooting
									</a>
								</li>
							}
						</ul>
						<div class="divider"></div>
						<!-- User Info & Logout -->
						<div class="flex items-center justify-between px-4 py-3 bg-base-200 rounded-xl border border-base-300 shadow-sm">
							<button
								class="flex flex-col items-start hover:opacity-70 transition-opacity text-left grow"
								hx-get="/api/user/password"
								hx-target="#modal-container"
							>
								<span class="text-sm font-bold truncate w-32">{ username }</span>
								<span class="text-[10px] opacity-50 uppercase tracking-widest font-bold">Administrator</span>
							</button>
							<form action="/logout" method="POST" class="ml-2">
								<button type="submit" class="btn btn-ghost btn-xs text-error btn-circle" title="Logout">
									<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
								</button>
							</form>
						</div>
					</div>
				</div>
			</div>
			<!-- Container for dynamic modals -->
			<div id="modal-container"></div>
			<!-- Toast container -->
			<div id="toast-container" class="toast toast-top toast-end z-50"></div>
			<script>
				function showToast(msg, type) {
					var alertClass = type === 'success' ? 'alert-success' : type === 'error' ? 'alert-error' : 'alert-info';
					var toast = document.createElement('div');
					toast.className = 'alert ' + alertClass + ' shadow-lg max-w-xs animate-in slide-in-from-top-2';
					toast.innerHTML = '<span>' + msg + '</span>';
					var container = document.getElementById('toast-container');
					if (container) {
						container.appendChild(toast);
						setTimeout(function() { toast.remove(); }, 4000);
					}
				}

				function checkToastCookie() {
					var cookies = document.cookie.split(';');
					for (var i = 0; i < cookies.length; i++) {
						var c = cookies[i].trim();
						if (c.indexOf('reducarr_toast=') === 0) {
							var val = decodeURIComponent(c.substring('reducarr_toast='.length));
							document.cookie = 'reducarr_toast=; Path=/; Max-Age=-1;';
							var parts = val.split(':');
							var type = parts[0] || 'info';
							var msg = parts.slice(1).join(':') || val;
							showToast(msg, type);
							break;
						}
					}
				}

				document.addEventListener('DOMContentLoaded', function() {
					checkToastCookie();
				});

				document.addEventListener('showToast', function(e) {
					var detail = e.detail;
					showToast((detail && detail.msg) || 'Notification', (detail && detail.type) || 'info');
				});
			</script>
		</body>
	</html>
}
