package web

import (
	"fmt"
)

// BuildInfo holds build-time metadata displayed in the Settings page.
type BuildInfo struct {
	Version   string
	Commit    string
	GoVersion string
	BuildTime string
}

templ SettingsPage(username string, configContent string, progress ScanProgress, info BuildInfo) {
	@Layout("Settings", username, nil) {
		<div class="space-y-8 animate-in fade-in duration-500">
			<div>
				<h1 class="text-3xl font-bold mb-1 tracking-tight text-left">Settings</h1>
				<p class="text-sm sm:text-base text-base-content/60 font-medium text-left">System configuration and maintenance.</p>
			</div>
			<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
				<!-- System Actions (First on Mobile, Right Sidebar on Desktop) -->
				<div class="space-y-6 lg:order-2">
					<div class="card bg-base-100 shadow-sm border border-base-300">
						<div class="card-body">
							<h2 class="card-title text-lg font-bold">Manual Scans</h2>
							@ScanControls(progress)
							<p class="text-[10px] opacity-50 mt-4 leading-tight italic text-center text-left">
								Note: Scans run in the background. You can navigate away and check the Dashboard for results.
							</p>
						</div>
					</div>
					<div class="card bg-base-100 shadow border border-base-300 overflow-hidden">
						<div class="card-body p-0 text-left">
							<div class="p-4 bg-base-200/50 border-b border-base-300">
								<h2 class="card-title text-xs font-black uppercase tracking-widest opacity-40">Build Info</h2>
							</div>
							<div class="p-4 space-y-2">
								<div class="flex justify-between text-xs">
									<span class="opacity-50">Version</span>
									<span class="font-mono font-bold">{ info.Version }</span>
								</div>
								<div class="flex justify-between text-xs">
									<span class="opacity-50">Commit</span>
									<span class="font-mono font-bold">{ info.Commit }</span>
								</div>
								<div class="flex justify-between text-xs">
									<span class="opacity-50">Go Version</span>
									<span class="font-mono font-bold">{ info.GoVersion }</span>
								</div>
								<div class="flex justify-between text-xs">
									<span class="opacity-50">Built</span>
									<span class="font-mono font-bold">{ info.BuildTime }</span>
								</div>
							</div>
						</div>
					</div>
					<div class="card bg-base-100 shadow border border-base-300 overflow-hidden">
						<div class="card-body p-0 text-left">
							<div class="p-4 bg-base-200/50 border-b border-base-300">
								<h2 class="card-title text-xs font-black uppercase tracking-widest opacity-40">Service Health</h2>
							</div>
							<div class="p-4">
								<div id="health-info" hx-get="/api/health" hx-trigger="load, health-refresh from:body">
									<!-- Health info will be loaded via HTMX -->
								</div>
							</div>
						</div>
					</div>
				</div>
				<!-- Config Editor (Second on Mobile, Left Main Area on Desktop) -->
				<div class="lg:col-span-2 space-y-4 lg:order-1">
					<div class="card bg-base-100 shadow-sm border border-base-300 overflow-hidden">
						<div class="card-body p-0 text-left">
							<div class="flex items-center justify-between p-4 border-b border-base-300 bg-base-200/50 rounded-t-xl">
								<h2 class="card-title text-xs uppercase tracking-widest font-black opacity-40">config.yaml</h2>
								<div id="config-status"></div>
							</div>
							<div class="w-full">
								<div id="ace-editor" style="height: 500px; width: 100%;" class="text-sm">{ configContent }</div>
							</div>
							<form
								id="config-form"
								hx-post="/api/config"
								hx-target="#config-status"
								hx-trigger="submit"
								class="flex flex-col"
							>
								<!-- Hidden input to store Ace content for HTMX -->
								<input type="hidden" name="content" id="config-content-hidden"/>
								<div class="p-4 bg-base-200/50 flex justify-end rounded-b-xl border-t border-base-300">
									<button type="submit" class="btn btn-primary btn-sm px-10 font-bold shadow-lg">Save Configuration</button>
								</div>
							</form>
						</div>
					</div>
				</div>
			</div>
		</div>
		<!-- Ace Editor Initialization -->
		<script src="https://cdn.jsdelivr.net/npm/ace-builds@1.44.0/src-min-noconflict/ace.min.js"></script>
		<script src="https://cdn.jsdelivr.net/npm/ace-builds@1.44.0/src-min-noconflict/mode-yaml.min.js"></script>
		<script src="https://cdn.jsdelivr.net/npm/ace-builds@1.44.0/src-min-noconflict/theme-monokai.min.js"></script>
		<script>
			(function() {
				const editor = ace.edit("ace-editor");
				editor.setTheme("ace/theme/monokai");
				editor.session.setMode("ace/mode/yaml");
				editor.setOptions({
					useSoftTabs: true,
					tabSize: 4,
					fontSize: "12px",
					showPrintMargin: false,
					scrollPastEnd: 0.1,
				});
				editor.resize();

				const form = document.getElementById('config-form');
				const hiddenInput = document.getElementById('config-content-hidden');

				// Update hidden input before HTMX request
				form.addEventListener('submit', function() {
					hiddenInput.value = editor.getValue();
				});

				// Trigger health refresh after config save
				document.body.addEventListener('htmx:afterRequest', function(evt) {
					if (evt.detail.path === '/api/config' && evt.detail.successful) {
						document.body.dispatchEvent(new CustomEvent('health-refresh'));
					}
				});
			})();
		</script>
	}
}

templ ScanControls(progress ScanProgress) {
	if progress.IsRunning {
		<div
			id="scan-controls"
			class="space-y-4"
			hx-get="/api/scan/status"
			hx-trigger="every 1s"
			hx-swap="outerHTML"
		>
			<div class="p-4 rounded-xl bg-base-200/60 border border-base-300 space-y-3 text-left">
				<div class="flex items-center justify-between">
					<div class="flex items-center gap-2">
						<span class="loading loading-spinner loading-md text-primary"></span>
						<span class="text-xs font-bold uppercase tracking-wider text-primary">
							if progress.ScanType == "incremental" {
								Incremental Scan
							} else {
								Full Scan
							}
						</span>
					</div>
					<span class="badge badge-primary badge-sm font-mono font-bold">{ fmt.Sprintf("%d%%", progress.OverallPercent()) }</span>
				</div>

				<!-- Overall Progress Bar -->
				<div class="w-full space-y-1">
					<progress class="progress progress-primary w-full" value={ fmt.Sprintf("%d", progress.OverallPercent()) } max="100"></progress>
				</div>

				if progress.CurrentItem != "" {
					<p class="text-xs text-base-content/70 font-mono truncate" title={ progress.CurrentItem }>
						<span class="opacity-50">Current:</span> { progress.CurrentItem }
					</p>
				}

				<!-- Category Breakdown (Torrents, Sonarr, Radarr) -->
				<div class="space-y-2 pt-2 border-t border-base-300/50 text-xs">
					<!-- Torrents Progress -->
					<div class="space-y-1">
						<div class="flex justify-between items-center text-[11px]">
							<span class="font-semibold opacity-70">Torrents</span>
							<span class="font-mono text-[10px] opacity-80">
								if progress.TorrentsTotal > 0 {
									{ fmt.Sprintf("%d/%d (%d%% remain)", progress.TorrentsDone, progress.TorrentsTotal, 100 - progress.TorrentsPercent()) }
								} else if progress.Phase != "torrents" && progress.Phase != "idle" {
									Complete (0% remain)
								} else {
									Pending
								}
							</span>
						</div>
						<progress class="progress progress-accent h-1.5 w-full" value={ fmt.Sprintf("%d", progress.TorrentsPercent()) } max="100"></progress>
					</div>

					<!-- Sonarr Progress -->
					<div class="space-y-1">
						<div class="flex justify-between items-center text-[11px]">
							<span class="font-semibold opacity-70">Sonarr</span>
							<span class="font-mono text-[10px] opacity-80">
								if progress.SonarrTotal > 0 {
									{ fmt.Sprintf("%d/%d (%d%% remain)", progress.SonarrDone, progress.SonarrTotal, 100 - progress.SonarrPercent()) }
								} else if progress.Phase == "radarr" || progress.Phase == "completed" {
									Complete (0% remain)
								} else {
									Pending
								}
							</span>
						</div>
						<progress class="progress progress-info h-1.5 w-full" value={ fmt.Sprintf("%d", progress.SonarrPercent()) } max="100"></progress>
					</div>

					<!-- Radarr Progress -->
					<div class="space-y-1">
						<div class="flex justify-between items-center text-[11px]">
							<span class="font-semibold opacity-70">Radarr</span>
							<span class="font-mono text-[10px] opacity-80">
								if progress.RadarrTotal > 0 {
									{ fmt.Sprintf("%d/%d (%d%% remain)", progress.RadarrDone, progress.RadarrTotal, 100 - progress.RadarrPercent()) }
								} else if progress.Phase == "completed" {
									Complete (0% remain)
								} else {
									Pending
								}
							</span>
						</div>
						<progress class="progress progress-warning h-1.5 w-full" value={ fmt.Sprintf("%d", progress.RadarrPercent()) } max="100"></progress>
					</div>
				</div>

				if progress.TotalScanned > 0 || progress.TotalCandidate > 0 {
					<div class="flex justify-between text-[11px] pt-1 opacity-70 border-t border-base-300/30">
						<span>Scanned: <strong class="font-mono">{ fmt.Sprintf("%d", progress.TotalScanned) }</strong></span>
						<span>Candidates: <strong class="font-mono text-warning">{ fmt.Sprintf("%d", progress.TotalCandidate) }</strong></span>
					</div>
				}
			</div>

			<button disabled class="btn btn-block btn-disabled opacity-30 font-bold">Start Full Scan</button>
			<button disabled class="btn btn-block btn-disabled opacity-30 font-bold">Start Incremental Scan</button>
		</div>
	} else {
		<div id="scan-controls" class="space-y-4">
			if progress.Phase == "completed" {
				<div class="alert alert-success py-2.5 shadow-sm text-xs font-bold text-left">
					<svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-4 w-4" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
					<span>Last scan completed! ({ fmt.Sprintf("%d", progress.TotalScanned) } files checked, { fmt.Sprintf("%d", progress.TotalCandidate) } candidates found)</span>
				</div>
			}
			<button
				class="btn btn-block btn-primary font-bold shadow-md"
				hx-post="/api/scan/full"
				hx-target="#scan-controls"
				hx-swap="outerHTML"
			>
				Start Full Scan
			</button>
			<button
				class="btn btn-block btn-outline font-bold"
				hx-post="/api/scan/incremental"
				hx-target="#scan-controls"
				hx-swap="outerHTML"
			>
				Start Incremental Scan
			</button>
		</div>
	}
}

templ HealthInfo(results []HealthResult) {
	<div class="space-y-2">
		if len(results) == 0 {
			<p class="text-xs text-base-content/50 italic">No services configured</p>
		} else {
			for _, res := range results {
				<div class="flex items-center justify-between text-xs">
					<div class="flex items-center gap-2">
						<span class="opacity-70">{ res.Name }</span>
						<span class="text-base-content/40">({ res.Type })</span>
					</div>
					if res.Healthy {
						<div class="badge badge-success badge-soft text-xs">Connected</div>
					} else {
						<div class="badge badge-error badge-soft text-xs" title={ res.Error }>Failed</div>
					}
				</div>
			}
		}
	</div>
}
