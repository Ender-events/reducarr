package web

import (
	"fmt"
	"strings"

	"github.com/Ender-events/reducarr/internal/db"
	"github.com/dustin/go-humanize"
)

templ ReportItem(username string, r db.ReportRecord) {
	<div
		id={ fmt.Sprintf("report-item-%d", r.ID) }
		class={ "card md:card-side bg-base-100 md:bg-transparent shadow-sm md:shadow-none border border-base-300 md:border-none hover:bg-base-200/50 transition-colors group", templ.KV("border-l-4 border-l-error bg-error/5", r.Status == "FAILED" && !r.IsRead) }
		if r.Status == "FAILED" && !r.IsRead {
			hx-post={ fmt.Sprintf("/api/reports/%d/read", r.ID) }
			hx-trigger="mouseenter once"
			hx-target="this"
			hx-swap="outerHTML"
		}
	>
		<div class="card-body p-4 md:p-0 md:grid md:grid-cols-[150px_100px_1fr_100px_120px] md:items-center md:gap-4 w-full">

			<!-- Date & Time -->
			<div class="flex justify-between md:block">
				<span class="text-[10px] sm:text-xs opacity-70 whitespace-nowrap font-mono">{ r.CreatedAt }</span>
				<div class="md:hidden">
					if r.Status == "SUCCESS" {
						<div class="badge badge-success badge-soft badge-xs">Success</div>
					} else if r.Status == "WARNING" {
						<div class="badge badge-warning badge-soft badge-xs">Warning ({ len(r.WarningMessages) })</div>
					} else {
						<div class="badge badge-error badge-soft badge-xs">
							if !r.IsRead {
								<span class="inline-block w-1.5 h-1.5 rounded-full bg-error animate-pulse mr-1"></span>
							}
							Failed
						</div>
					}
				</div>
			</div>

			<!-- Action Badge -->
			<div class="flex items-center">
				<div class={ "badge badge-xs sm:badge-sm font-bold", templ.KV("badge-primary", r.ActionType == "UPGRADE"), templ.KV("badge-secondary", r.ActionType == "DELETE") }>
					{ r.ActionType }
				</div>
			</div>

			<!-- Item Title & Path -->
			<div class="flex flex-col min-w-0 text-left">
				<a href={ templ.SafeURL(fmt.Sprintf("/reports/%d", r.ID)) } class="font-bold truncate text-sm sm:text-base group-hover:text-primary transition-colors text-left flex items-center gap-1.5">
					if r.Status == "FAILED" && !r.IsRead {
						<span class="inline-block w-2 h-2 rounded-full bg-error shrink-0 animate-pulse" title="Unread failure"></span>
					}
					<span class="truncate">{ r.ItemTitle }</span>
				</a>
				<span class="text-[10px] sm:text-xs opacity-50 truncate text-left" title={ r.MainFilePath }>{ r.MainFilePath }</span>
			</div>

			<!-- Status (Desktop Only) -->
			<div class="hidden md:flex items-center">
				if r.Status == "SUCCESS" {
					<div class="badge badge-success badge-soft badge-sm">Success</div>
				} else if r.Status == "WARNING" {
					<div class="badge badge-warning badge-soft badge-sm" title={ strings.Join(r.WarningMessages, ", ") }>Warning ({ len(r.WarningMessages) })</div>
				} else {
					<div class="badge badge-error badge-soft badge-sm" title={ r.ErrorMessage }>
						if !r.IsRead {
							<span class="inline-block w-1.5 h-1.5 rounded-full bg-error animate-pulse mr-1"></span>
						}
						Failed
					</div>
				}
			</div>

			<!-- Net Saved -->
			<div class="flex justify-between md:block items-center mt-2 md:mt-0">
				<span class="md:hidden text-[10px] opacity-50 uppercase font-bold tracking-wider">Net Saved</span>
				<div class="font-mono text-right text-sm font-bold">
					if r.Status == "SUCCESS" || r.Status == "WARNING" {
						if r.ActionType == "UPGRADE" && r.TotalSizeAfter > 0 {
							<span class="text-success">+{ humanize.Bytes(uint64(r.TotalSizeBefore - r.TotalSizeAfter)) }</span>
						} else if r.ActionType == "DELETE" {
							<span class="text-success">+{ humanize.Bytes(uint64(r.TotalSizeBefore)) }</span>
						} else {
							<span class="opacity-30">0 B</span>
						}
					} else {
						<span class="opacity-30">-</span>
					}
				</div>
			</div>
		</div>
	</div>
}

templ ReportsPage(username string, reports []db.ReportRecord, currentStatus string, currentAction string, currentSort string, currentOrder string, availableActions []string, navStats NavStats) {
	@Layout("Reports", username, LayoutOptions{NavStats: navStats}) {
		<div class="space-y-6">
			<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
				<div>
					<h1 class="text-2xl sm:text-3xl font-bold mb-1">Operation Reports</h1>
					<p class="text-sm sm:text-base text-base-content/60">History of optimizations and actions performed.</p>
				</div>
				<div class="flex flex-wrap items-center gap-3">
					<!-- Reset button -->
					<a
						href="/reports"
						class={ "btn btn-xs sm:btn-sm btn-ghost gap-1 border border-base-300 shadow-sm", templ.KV("text-error border-error/50", (currentStatus != "" && currentStatus != "ALL") || (currentAction != "" && currentAction != "ALL") || currentSort != "") }
						title="Reset all filters and sorting"
					>
						<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
						<span>Reset</span>
					</a>

					if navStats.DownloadingCount > 0 {
						<div class="badge badge-info badge-soft badge-md sm:badge-lg gap-1.5 whitespace-nowrap self-start sm:self-auto" title="Active torrent downloads in client">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
							<span>{ fmt.Sprintf("%d downloading", navStats.DownloadingCount) }</span>
						</div>
					}
					<div class="badge badge-outline badge-md sm:badge-lg whitespace-nowrap self-start sm:self-auto">{ fmt.Sprintf("%d records", len(reports)) }</div>
				</div>
			</div>

			<div class="flex flex-col gap-4">
				<!-- Header (Desktop Only) with Sorting & Filtering (relative z-30 for dropdown overlays) -->
				<div class="hidden md:grid md:grid-cols-[150px_100px_1fr_100px_120px] md:gap-4 px-4 py-2 text-xs font-bold uppercase tracking-widest text-base-content/70 border-b border-base-300 items-center relative z-30">
					<!-- Date column with sort toggle -->
					<div>
						<a
							href={ templ.SafeURL(reportDateSortURL(currentStatus, currentAction, currentSort, currentOrder)) }
							class="inline-flex items-center gap-1 hover:text-primary transition-colors cursor-pointer select-none"
							title="Sort by Date (click to toggle ascending / descending)"
						>
							<span>Date</span>
							if currentSort == "date" {
								if currentOrder == "asc" {
									<span class="text-primary font-bold">↑</span>
								} else {
									<span class="text-primary font-bold">↓</span>
								}
							}
						</a>
					</div>

					<!-- Action column with dropdown filter -->
					<div>
						<div class="dropdown">
							<div
								tabindex="0"
								role="button"
								class="inline-flex items-center gap-1 hover:text-primary transition-colors cursor-pointer select-none"
								title="Filter by Action"
							>
								<span>Action</span>
								<svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
							</div>
							<ul tabindex="0" class="dropdown-content menu p-2 shadow-2xl bg-base-100 rounded-box w-36 z-50 border border-base-300 normal-case font-normal tracking-normal text-xs">
								<li>
									<a
										href={ templ.SafeURL(reportFilterURL(currentStatus, "ALL", currentSort, currentOrder)) }
										class={ templ.KV("active font-bold", currentAction == "" || currentAction == "ALL") }
									>
										ALL
									</a>
								</li>
								for _, act := range availableActions {
									<li>
										<a
											href={ templ.SafeURL(reportFilterURL(currentStatus, act, currentSort, currentOrder)) }
											class={ templ.KV("active font-bold", currentAction == act) }
										>
											{ act }
										</a>
									</li>
								}
							</ul>
						</div>
					</div>

					<!-- Item column with alphabetical sort toggle -->
					<div>
						<a
							href={ templ.SafeURL(reportItemSortURL(currentStatus, currentAction, currentSort, currentOrder)) }
							class="inline-flex items-center gap-1 hover:text-primary transition-colors cursor-pointer select-none"
							title="Sort by Item name (click to toggle A-Z / Z-A)"
						>
							<span>Item</span>
							if currentSort == "item" {
								if currentOrder == "asc" {
									<span class="text-primary font-bold">↑</span>
								} else {
									<span class="text-primary font-bold">↓</span>
								}
							}
						</a>
					</div>

					<!-- Status column with dropdown filter -->
					<div>
						<div class="dropdown">
							<div
								tabindex="0"
								role="button"
								class="inline-flex items-center gap-1 hover:text-primary transition-colors cursor-pointer select-none"
								title="Filter by Status"
							>
								<span>Status</span>
								<svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
							</div>
							<ul tabindex="0" class="dropdown-content menu p-2 shadow-2xl bg-base-100 rounded-box w-36 z-50 border border-base-300 normal-case font-normal tracking-normal text-xs">
								<li>
									<a
										href={ templ.SafeURL(reportFilterURL("ALL", currentAction, currentSort, currentOrder)) }
										class={ templ.KV("active font-bold", currentStatus == "" || currentStatus == "ALL") }
									>
										ALL
									</a>
								</li>
								<li>
									<a
										href={ templ.SafeURL(reportFilterURL("SUCCESS", currentAction, currentSort, currentOrder)) }
										class={ templ.KV("active font-bold", currentStatus == "SUCCESS") }
									>
										SUCCESS
									</a>
								</li>
								<li>
									<a
										href={ templ.SafeURL(reportFilterURL("WARNING", currentAction, currentSort, currentOrder)) }
										class={ templ.KV("active font-bold", currentStatus == "WARNING") }
									>
										WARNING
									</a>
								</li>
								<li>
									<a
										href={ templ.SafeURL(reportFilterURL("FAILED", currentAction, currentSort, currentOrder)) }
										class={ templ.KV("active font-bold", currentStatus == "FAILED") }
									>
										FAILED
									</a>
								</li>
							</ul>
						</div>
					</div>

					<!-- Net Saved column with numeric sort toggle -->
					<div class="text-right">
						<a
							href={ templ.SafeURL(reportSavedSortURL(currentStatus, currentAction, currentSort, currentOrder)) }
							class="inline-flex items-center gap-1 hover:text-primary transition-colors cursor-pointer select-none"
							title="Sort by Net Saved (click to toggle descending / ascending)"
						>
							<span>Net Saved</span>
							if currentSort == "saved" {
								if currentOrder == "asc" {
									<span class="text-primary font-bold">↑</span>
								} else {
									<span class="text-primary font-bold">↓</span>
								}
							}
						</a>
					</div>
				</div>

				if len(reports) == 0 {
					<div class="card bg-base-100 shadow border border-base-300 py-12">
						<div class="flex flex-col items-center gap-2 opacity-50">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
							<p class="text-lg font-medium">No reports found</p>
						</div>
					</div>
				} else {
					for _, r := range reports {
						@ReportItem(username, r)
					}
				}
			</div>
		</div>
	}
}
